[Unit]
Description=Oriel web server (Vue, server-rendered), %i slot
After=network.target oriel-vue-api@%i.service
Wants=oriel-vue-api@%i.service
ConditionPathExists=/var/www/oriel-vue.jeffgicharu.com/slots/%i/node/bin/node

[Service]
Type=simple
User=oriel-vue-web
Group=oriel-vue-web
WorkingDirectory=/var/www/oriel-vue.jeffgicharu.com/slots/%i/web
EnvironmentFile=/var/www/oriel-vue.jeffgicharu.com/shared/web.env
# The slot's ports. The web server listens on 127.0.0.1 and renders pages
# from its own slot's API on 127.0.0.1, never through nginx.
EnvironmentFile=/var/www/oriel-vue.jeffgicharu.com/shared/%i.ports
Environment=NODE_ENV=production
# Node ships inside each release. The heap limit keeps the process well
# inside MemoryMax, so V8 collects before systemd would ever kill it.
ExecStart=/var/www/oriel-vue.jeffgicharu.com/slots/%i/node/bin/node --max-old-space-size=160 --disable-proto=delete server.mjs
Restart=on-failure
RestartSec=3
# On SIGTERM the server stops taking new requests and finishes the ones in hand.
KillSignal=SIGTERM
TimeoutStopSec=20
# Two slots run side by side for about a minute during a release.
MemoryMax=256M
MemorySwapMax=0
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Nothing outside this machine is ever called.
IPAddressDeny=any
IPAddressAllow=localhost
# The web server writes nothing: it has no data and no settings of its own.

[Install]
WantedBy=multi-user.target
